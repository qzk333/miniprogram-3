/* 物品信息卡片 */
.info-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}
.header-img {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.price-wrap {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.deposit { margin-left: 30rpx; color: #666; }
.waived { text-decoration: line-through; color: #07c160; }

/* ========== 日历卡片 ========== */
.calendar-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}
.cal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.cal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A202C;
}
.cal-status {
  font-size: 24rpx;
  color: #007AFF;
}

/* 星期标题行 */
.weekday-row {
  display: flex;
  margin-bottom: 10rpx;
}
.weekday {
  width: calc(100% / 7);
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0;
  font-weight: 500;
}
.weekend-header {
  color: #E53E3E;
}

/* 日历网格 */
.days-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-box {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #333;
  position: relative;
}

.empty-cell {
  /* 空占位格不可见 */
}

/* 已借出：灰色背景块，与图例 .legend-dot.taken 一致 */
.disabled {
  background: #ececec;
  border-color: #dcdcdc;
  color: #8a8a8a;
}

.disabled .date-txt {
  color: #8a8a8a;
  font-weight: 500;
}

/* 已借出的周末不再用红色，避免与「不可选」状态混淆 */
.disabled.weekend .date-txt {
  color: #8a8a8a;
}

.selected {
  background: #00561F;
  color: #fff;
  border-color: #00561F;
  font-weight: bold;
}

.selected .date-txt {
  color: #fff;
}

.weekend .date-txt {
  color: #E53E3E;
}

.selected.weekend .date-txt {
  color: #fff;
}

.date-txt {
  line-height: 1;
}

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin: 20rpx 0 10rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #999;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}
.legend-dot.free { background: #fff; border: 2rpx solid #ddd; }
.legend-dot.taken { background: #f0f0f0; border: 2rpx solid #e0e0e0; }
.legend-dot.picked { background: #00561F; }

/* 按钮 */
.reset-btn {
  width: 100%;
  margin-top: 10rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}
.book-btn {
  width: 90% !important;
  margin: 40rpx auto;
  border-radius: 40rpx;
  background: #00561F !important;
  color: #fff !important;
}

.desc-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}
.desc-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.desc-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

.contact-card,
.comment-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A202C;
  margin-bottom: 20rpx;
}
.contact-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.contact-label {
  width: 80rpx;
  font-size: 26rpx;
  color: #666;
}
.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.copy-btn {
  margin: 0 !important;
  background: #00561F !important;
  color: #fff !important;
  border: none;
}
.copy-btn::after {
  border: none;
}

.comment-list {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}
.comment-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.comment-meta {
  margin-bottom: 8rpx;
}
.comment-author {
  font-size: 24rpx;
  color: #00561F;
  font-weight: 500;
}
.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.comment-empty {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 0;
}
.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.comment-send {
  margin: 0 !important;
  background: #00561F !important;
  color: #fff !important;
}
.comment-send::after {
  border: none;
}

.rent-estimate {
  font-size: 26rpx;
  color: #00561F;
  background: rgba(0, 86, 31, 0.06);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
