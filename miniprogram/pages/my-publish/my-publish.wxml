<view class="container">
  <view class="item-card" wx:for="{{itemList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
    <image src="{{item.image}}" mode="aspectFill" class="item-img"></image>
    <view class="item-info">
      <text class="title">{{item.title}}</text>
      <text class="price">{{item.category || '未分类'}}</text>
      <text class="price">日租: ¥{{item.rentPrice}} | 押金: ¥{{item.deposit}}</text>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="empty" wx:if="{{isEmpty}}">
    <text class="empty-text">还没有发布任何物品</text>
    <button class="empty-btn" bindtap="goToPublish">去发布</button>
  </view>
</view>
