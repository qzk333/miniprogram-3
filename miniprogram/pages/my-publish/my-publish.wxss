page {
  background: #f5f5f5;
  height: 100vh;
}

.page-wrapper {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(245, 247, 250, 0);
  backdrop-filter: blur(8px);
  z-index: -1;
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-tip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.login-tip-text {
  display: block;
  font-size: 28rpx;
  color: #718096;
  margin-bottom: 32rpx;
}

.login-tip-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #00561F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.page-header {
  margin-bottom: 28rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 86, 31, 0.08);
}

.page-header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #00561F;
  letter-spacing: 1rpx;
}

.item-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.item-main {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.item-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #EDF2F7;
}

.item-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A202C;
  line-height: 1.4;
}

.meta {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.5;
}

.arrow {
  font-size: 48rpx;
  color: #CBD5E0;
  margin-left: 16rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  padding: 0 32rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.delete-btn {
  margin: 0;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #E53E3E !important;
  background: #FFF5F5 !important;
  border-radius: 28rpx;
}

.delete-btn::after {
  border: none;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A0AEC0;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 260rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #00561F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.fab-publish {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #00561F;
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 86, 31, 0.35);
  z-index: 100;
}

.fab-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 500;
}
