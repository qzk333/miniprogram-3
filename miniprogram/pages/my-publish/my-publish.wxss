.container {
  padding: 30rpx;
  background: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #EDF2F7;
}

.item-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A202C;
}

.price {
  font-size: 24rpx;
  color: #718096;
}

.arrow {
  font-size: 40rpx;
  color: #CBD5E0;
  margin-left: 12rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A0AEC0;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #00561F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
