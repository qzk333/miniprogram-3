.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.order-info {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  line-height: 2;
  font-size: 28rpx;
  color: #333;
}

.title {
  font-weight: bold;
  font-size: 32rpx;
}

/* 步骤条 */
.stepper {
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 20rpx 28rpx;
  margin-bottom: 24rpx;
}

.stepper-row {
  display: flex;
  align-items: flex-start;
}

.stepper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 88rpx;
  flex-shrink: 0;
}

.stepper-node {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #edf2f7;
  color: #a0aec0;
  font-size: 24rpx;
  font-weight: 600;
}

.stepper-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a0aec0;
  white-space: nowrap;
}

.stepper-line {
  flex: 1;
  height: 4rpx;
  background: #e2e8f0;
  border-radius: 2rpx;
  margin-top: 20rpx;
  min-width: 24rpx;
}

.stepper-line.done {
  background: #00561F;
}

.stepper-item.current .stepper-node {
  background: #00561F;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 86, 31, 0.25);
}

.stepper-item.current .stepper-label {
  color: #00561F;
  font-weight: 600;
}

.stepper-item.done .stepper-node {
  background: #00561F;
  color: #fff;
}

.stepper-item.done .stepper-label {
  color: #00561F;
}

.action-card {
  background: #fff;
  padding: 36rpx 30rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: #1a202c;
}

.desc {
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 28rpx;
  line-height: 1.6;
}

.card-btn {
  width: 100% !important;
  margin: 0 0 16rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #f5f7fa !important;
  color: #333 !important;
}

.card-btn.primary {
  background: #00561F !important;
  color: #fff !important;
}

.card-btn::after {
  border: none;
}

.proof-img {
  width: 100%;
  height: 300rpx;
  margin: 8rpx 0 24rpx;
  border-radius: 12rpx;
}

.done-card .done-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #e8f5e9;
  color: #00561F;
  font-size: 44rpx;
  font-weight: bold;
}

.footer-nav {
  margin-top: 20rpx;
}

.footer-btn {
  width: 100% !important;
  margin: 16rpx 0 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #00561F !important;
  color: #fff !important;
}

.footer-btn.secondary {
  background: #f5f5f5 !important;
  color: #333 !important;
}

.footer-btn::after {
  border: none;
}

/* 成功页 */
.success-page {
  min-height: calc(100vh - 60rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.success-icon-wrap {
  margin-bottom: 28rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  color: #00561F;
  font-size: 60rpx;
  font-weight: bold;
}

.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a202c;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.success-hint {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.6;
  background: #f7fafc;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 0 28rpx;
  text-align: left;
}

.success-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
}

.role-row {
  margin-top: 8rpx;
}

.role-badge {
  display: inline-block;
  font-size: 24rpx;
  color: #00561F;
  background: #e8f5e9;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.guest-tip {
  font-size: 24rpx;
  color: #e53e3e;
  margin-top: 8rpx;
}

.wait-tip {
  font-size: 26rpx;
  color: #718096;
  padding: 16rpx 0;
}

.confirm-done {
  font-size: 28rpx;
  color: #00561F;
  padding: 16rpx 0;
  font-weight: 500;
}

.pending-hint {
  font-size: 24rpx;
  color: #f59e0b;
  margin-top: 12rpx;
}

.settle-tip {
  font-size: 26rpx;
  color: #00561F;
  margin-bottom: 20rpx;
}

.pay-card {
  border: 2rpx solid #e8f5e9;
}

.pay-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #00561F;
  margin: 16rpx 0;
}

.pay-status-tag {
  font-size: 24rpx;
  color: #718096;
}

.pay-status-tag.paid {
  color: #00561F;
}

.pay-status-tag.settled {
  color: #2d8a4e;
}
