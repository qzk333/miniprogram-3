.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.order-info {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  line-height: 2;
  font-size: 28rpx;
  color: #333;
}

.title {
  font-weight: bold;
  font-size: 32rpx;
}

/* 步骤条 */
.steps-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 20rpx;
  color: #999;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  gap: 8rpx;
}

.step-dot {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8e8e8;
  color: #999;
  font-size: 22rpx;
}

.step.current .step-dot {
  background: #00561F;
  color: #fff;
}

.step.done {
  color: #00561F;
}

.step.done .step-dot {
  background: #00561F;
  color: #fff;
}

.step-line {
  flex: 0 0 24rpx;
  height: 4rpx;
  background: #e8e8e8;
  margin-bottom: 28rpx;
}

.step-line.done {
  background: #00561F;
}

.action-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #1a202c;
}

.desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.proof-img {
  width: 100%;
  height: 300rpx;
  margin: 20rpx 0;
  border-radius: 8rpx;
}

.done-card .done-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #e8f5e9;
  color: #00561F;
  font-size: 44rpx;
  font-weight: bold;
}

.footer-nav {
  margin-top: 20rpx;
}

.footer-btn {
  width: 100% !important;
  margin: 16rpx 0 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #00561F !important;
  color: #fff !important;
}

.footer-btn.secondary {
  background: #f5f5f5 !important;
  color: #333 !important;
}

.footer-btn::after {
  border: none;
}
