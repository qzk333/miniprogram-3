/* Background & Layout */
page {
  background: #f5f5f5;
  height: 100vh;
}

.page-wrapper {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(245, 247, 250, 0);
  backdrop-filter: blur(8px);
  z-index: -1;
}

.content-container {
  position: relative;
  z-index: 1;
  padding-bottom: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Category Filter Bar */
.category-scroll {
  width: 100%;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-list {
  display: inline-flex;
  padding: 20rpx 30rpx;
}

.category-item {
  display: inline-block;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  background: #f5f7fa;
  transition: all 0.3s ease;
}

.category-item:last-child {
  margin-right: 0;
}

.category-item.active {
  color: #fff;
  background: #00561F;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 86, 31, 0.3);
}

/* Search Bar */
.search-bar-container {
  padding: 30rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #999;
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
}

.search-icon::after {
  content: "";
  position: absolute;
  bottom: -6rpx;
  right: -8rpx;
  width: 10rpx;
  height: 4rpx;
  background: #999;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #bbb;
}

/* Item List */
.item-list {
  padding: 0 30rpx;
}

.item-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.card-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.item-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.tag {
  font-size: 20rpx;
  color: #00561F;
  background: rgba(0, 86, 31, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.item-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: auto;
}

.price-rent {
  color: #E63F00;
  font-size: 36rpx;
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 4rpx;
}

.price-deposit {
  font-size: 24rpx;
  color: #999;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #ddd;
  border-radius: 16rpx;
  position: relative;
}

.empty-icon::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 30rpx;
  height: 6rpx;
  background: #ddd;
  border-radius: 4rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #aaa;
}