.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 48rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 56rpx 40rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: #fff5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  font-size: 56rpx;
  font-weight: bold;
  color: #e53e3e;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #a0aec0;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.btn {
  margin-bottom: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn.primary {
  background: #00561f;
  color: #fff;
}

.btn.secondary {
  background: #fff;
  color: #00561f;
  border: 2rpx solid #c6e6d0;
}
