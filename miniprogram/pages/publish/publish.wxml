<view class="page-wrapper">
  <image class="bg-image" src="/images/sysu1.jpg" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <view class="container">
  <!-- 第一部分：基本信息卡片 -->
  <view class="form-card">
    
    <!-- 物品名称 -->
    <view class="form-item">
      <text class="form-label">物品名称</text>
      <input class="form-input" placeholder="如: 考研平板/晚会正装" placeholder-class="placeholder-style" bindinput="inputTitle" value="{{title}}" />
    </view>

    <!-- 选择分类（带右箭头暗示可点击） -->
    <view class="form-item">
      <text class="form-label">物品分类</text>
      <picker class="form-picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-content">
          <text class="{{category ? 'picker-text' : 'picker-placeholder'}}">{{category || '请选择分类'}}</text>
          <view class="arrow-icon"></view>
        </view>
      </picker>
    </view>

    <!-- 日租金 -->
    <view class="form-item">
      <text class="form-label">日租金</text>
      <view class="input-wrapper">
        <input class="form-input align-right" type="number" placeholder="0.00" placeholder-class="placeholder-style" bindinput="inputRent" />
        <text class="unit-text">元/天</text>
      </view>
    </view>

    <!-- 押金 -->
    <view class="form-item no-border">
      <text class="form-label">线下押金</text>
      <view class="input-wrapper">
        <input class="form-input align-right" type="number" placeholder="0.00" placeholder-class="placeholder-style" bindinput="inputDeposit" />
        <text class="unit-text">元</text>
      </view>
    </view>

  </view>

  <!-- 第二部分：图片上传区卡片 -->
  <view class="upload-card">
    <text class="upload-title">物品主图</text>
    
    <!-- 将按钮和图片预览合并为一个1:1的图形化框 -->
    <view class="upload-box" bindtap="uploadImage">
      <block wx:if="{{imageUrl}}">
        <image src="{{imageUrl}}" class="preview-img" mode="aspectFill"></image>
        <view class="re-upload-bar">点击更换图片</view>
      </block>
      <block wx:else>
        <view class="upload-placeholder">
          <view class="plus-icon">+</view>
          <text class="upload-text">添加图片</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 第三部分：提交按钮（融入中大绿） -->
  <button class="submit-btn" bindtap="submitItem">发布物品</button>
  
</view>
</view>