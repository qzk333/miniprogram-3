page {
  background: #f5f5f5;
  height: 100vh;
}

.page-wrapper {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(245, 247, 250, 0);
  backdrop-filter: blur(8px);
  z-index: -1;
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-tip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.login-tip-text {
  display: block;
  font-size: 28rpx;
  color: #718096;
  margin-bottom: 32rpx;
}

.login-tip-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #00561F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.reminder-card {
  background: linear-gradient(135deg, #00561F, #2d8a4e);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
  color: #fff;
}

.reminder-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.reminder-text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.reminder-action {
  display: block;
  font-size: 24rpx;
  margin-top: 12rpx;
  opacity: 0.9;
  text-align: right;
}

.page-header {
  margin-bottom: 28rpx;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 86, 31, 0.08);
}

.page-header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #00561F;
  letter-spacing: 1rpx;
}

.order-card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
  min-height: 220rpx;
}

.order-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  gap: 20rpx;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.order-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A202C;
  line-height: 1.4;
}

.order-date {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.5;
}

.order-rent {
  font-size: 26rpx;
  color: #00561F;
  font-weight: 500;
}

.status-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
  margin-top: 4rpx;
}

.status-tag.awaiting_confirm {
  background: #EBF8FF;
  color: #3182CE;
}

.status-tag.awaiting_confirm {
  background: #ebf8ff;
  color: #3182ce;
}

.status-tag.pending {
  background: #FFF8E1;
  color: #F59E0B;
}

.status-tag.active {
  background: #E8F5E9;
  color: #00561F;
}

.status-tag.done {
  background: #EDF2F7;
  color: #718096;
}

.order-card.highlight {
  border: 2rpx solid #00561F;
  box-shadow: 0 4rpx 20rpx rgba(0, 86, 31, 0.15);
}

.order-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-slot {
  flex: 1;
  min-width: 0;
}

.action-btn,
.delete-btn,
.action-placeholder {
  width: 100% !important;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.action-btn {
  margin: 0;
  padding: 0;
  background: #00561F !important;
  color: #fff !important;
  border: none;
}

.action-btn::after {
  border: none;
}

.delete-btn {
  margin: 0;
  padding: 0;
  background: #fff !important;
  color: #e53e3e !important;
  border: 1rpx solid #fed7d7 !important;
}

.delete-btn::after {
  border: none;
}

.action-placeholder {
  background: transparent;
  color: transparent;
  border: 1rpx solid transparent;
  text-align: center;
  user-select: none;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A0AEC0;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #00561F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}
