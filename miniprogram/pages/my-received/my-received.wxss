@import "../my-orders/my-orders.wxss";

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.filter-tab {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #718096;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
}

.filter-tab.active {
  color: #fff;
  background: #00561F;
  font-weight: 500;
}

.order-role {
  font-size: 22rpx;
  color: #A0AEC0;
  margin-top: 4rpx;
}

.received-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 24rpx;
}

.accept-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #00561F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.reject-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #fff;
  color: #e53e3e;
  font-size: 28rpx;
  border: 2rpx solid #fed7d7;
  border-radius: 36rpx;
}
