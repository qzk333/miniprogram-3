<view class="container">
  <view
    class="msg-card {{item.isRead ? '' : 'unread'}}"
    wx:for="{{list}}"
    wx:key="_id"
    bindtap="goToDetail"
    data-item-id="{{item.itemId}}"
  >
    <view class="msg-header">
      <text class="msg-from">{{item.fromNickname}}</text>
      <text class="msg-type">{{item.typeText}}</text>
    </view>
    <text class="msg-item">物品：{{item.itemTitle}}</text>
    <text class="msg-content">{{item.content}}</text>
    <view class="msg-footer">
      <text class="msg-link">查看物品 ›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{isEmpty}}">
    <text class="empty-text">暂无收到的私信</text>
    <text class="empty-sub">他人在您发布的物品下留言或回复评论时会出现在这里</text>
  </view>
</view>
