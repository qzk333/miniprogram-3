.container {
  padding: 30rpx;
  background: #F8F9FA;
  min-height: 100vh;
  box-sizing: border-box;
}

.msg-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.msg-card.unread {
  border-left: 6rpx solid #E53E3E;
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.msg-from {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A202C;
}

.msg-type {
  font-size: 22rpx;
  color: #00561F;
  background: rgba(0, 86, 31, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.msg-item {
  display: block;
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 10rpx;
}

.msg-content {
  display: block;
  font-size: 28rpx;
  color: #2D3748;
  line-height: 1.5;
}

.msg-footer {
  margin-top: 16rpx;
  text-align: right;
}

.msg-link {
  font-size: 24rpx;
  color: #007AFF;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #A0AEC0;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #CBD5E0;
  padding: 0 40rpx;
  line-height: 1.6;
}
